global:
  scrape_interval: {{ prometheus_scrape_interval }}
  evaluation_interval: {{ prometheus_evaluation_interval }}

alerting:
  alertmanagers:
    - static_configs:
        - targets:
            - "{{ alertmanager_container_name }}:{{ alertmanager_port }}"

rule_files:
  - "{{ prometheus_rule_files }}"

scrape_configs:
{% for job in prometheus_targets %}
  - job_name: '{{ job.job_name }}'
    static_configs:
      - targets: {{ job.static_configs[0].targets | to_json }}
{% endfor %}

{% if groups['target-servers'] is defined and groups['target-servers'] | length > 0 %}
  - job_name: 'node-exporter'
    static_configs:
      - targets:
{% for host in groups['target-servers'] %}
          - '{{ hostvars[host].ansible_host | default(host) }}:9100'
{% endfor %}
{% endif %}
